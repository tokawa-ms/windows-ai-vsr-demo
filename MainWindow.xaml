<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsAiVsrCpuDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE714;"/>
            <TextBlock
                x:Name="AppTitleText"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Windows AI Video Super Resolution Demo"/>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBlock
                    x:Name="LanguageLabelText"
                    VerticalAlignment="Center"
                    Text="Language"/>
                <ComboBox
                    x:Name="LanguageComboBox"
                    MinWidth="120"
                    AutomationProperties.AutomationId="LanguageComboBox"
                    SelectionChanged="OnLanguageSelectionChanged">
                    <ComboBoxItem Content="English"
                            Tag="en"/>
                    <ComboBoxItem Content="日本語"
                            Tag="ja"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="24,16,24,12"
            RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="HeroTitleText"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Upscale video with AI"/>
                <TextBlock
                    x:Name="HeroDescriptionText"
                    Text="Compare the results in real time and save an MP4 with audio when needed."
                    TextWrapping="Wrap"/>
            </StackPanel>

            <InfoBar
                x:Name="HardwareInfoBar"
                Grid.Row="1"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind HardwareMessage, Mode=OneWay}"
                Severity="{x:Bind HardwareSeverity, Mode=OneWay}"
                Title="Processing hardware"/>

            <TabView
                Grid.Row="2"
                IsAddTabButtonVisible="False"
                TabWidthMode="SizeToContent">
                <TabViewItem
                    x:Name="RealtimeTab"
                    Header="Real-time VSR comparison"
                    IsClosable="False">
                    <Grid Padding="4,16,4,4"
                          RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="PickRealtimeInputVideoButton"
                                AutomationProperties.AutomationId="PickRealtimeInputVideoButton"
                                Command="{x:Bind PickInputCommand}"
                                Content="Choose a video to compare"
                                Style="{StaticResource AccentButtonStyle}"/>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind InputFileName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"/>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind InputDetails, Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="PlayPauseRealtimeButton"
                                    Command="{x:Bind PlayPauseRealtimeCommand}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <FontIcon Glyph="&#xE768;"/>
                                        <TextBlock Text="{x:Bind RealtimePlayPauseLabel, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="RestartRealtimeButton"
                                    AutomationProperties.AutomationId="RestartRealtimeButton"
                                    Command="{x:Bind RestartRealtimeCommand}"
                                    Content="Restart"/>
                                <TextBlock
                                    x:Name="ZoomLabelText"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Zoom"/>
                                <Slider
                                    x:Name="RealtimeZoomSlider"
                                    Width="200"
                                    AutomationProperties.AutomationId="RealtimeZoomSlider"
                                    AutomationProperties.Name="リアルタイム比較の拡大率"
                                    ValueChanged="OnRealtimeZoomChanged"/>
                                <TextBlock
                                    Width="58"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind RealtimeZoomText, Mode=OneWay}"/>
                                <Button
                                    x:Name="ResetRealtimeZoomButton"
                                    AutomationProperties.AutomationId="ResetRealtimeZoomButton"
                                    Command="{x:Bind ResetRealtimeZoomCommand}"
                                    Content="Reset"/>
                            </StackPanel>
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="OriginalRealtimeViewport"
                                Background="Black"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                SizeChanged="OnRealtimeViewportSizeChanged"
                                Tag="Original">
                                <Grid>
                                    <Image
                                        x:Name="OriginalRealtimeImage"
                                        AutomationProperties.AutomationId="OriginalRealtimePlayer"
                                        Source="{x:Bind OriginalRealtimeFrameSource, Mode=OneWay}"
                                        Stretch="Uniform">
                                        <Image.RenderTransform>
                                            <CompositeTransform x:Name="OriginalZoomTransform"/>
                                        </Image.RenderTransform>
                                    </Image>
                                    <Button
                                        x:Name="OriginalRealtimeFocusButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        AutomationProperties.AutomationId="OriginalRealtimeFocusButton"
                                        AutomationProperties.Name="原画の注目位置をクリックまたはドラッグして選択"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0.01"
                                        Padding="0"
                                        PointerCanceled="OnRealtimePlayerPointerCanceled"
                                        PointerCaptureLost="OnRealtimePlayerPointerCaptureLost"
                                        PointerMoved="OnRealtimePlayerPointerMoved"
                                        PointerPressed="OnRealtimePlayerPointerPressed"
                                        PointerReleased="OnRealtimePlayerPointerReleased"
                                        Tag="Original"/>
                                    <Border
                                        Margin="14"
                                        Padding="12,6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}">
                                        <TextBlock
                                            x:Name="OriginalLabelText"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="Original"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border
                                x:Name="VsrRealtimeViewport"
                                Grid.Column="1"
                                Background="Black"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                SizeChanged="OnRealtimeViewportSizeChanged"
                                Tag="Vsr">
                                <Grid>
                                    <Image
                                        x:Name="VsrRealtimeImage"
                                        AutomationProperties.AutomationId="VsrRealtimePlayer"
                                        Source="{x:Bind VsrRealtimeFrameSource, Mode=OneWay}"
                                        Stretch="Uniform">
                                        <Image.RenderTransform>
                                            <CompositeTransform x:Name="VsrZoomTransform"/>
                                        </Image.RenderTransform>
                                    </Image>
                                    <Button
                                        x:Name="VsrRealtimeFocusButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        AutomationProperties.AutomationId="VsrRealtimeFocusButton"
                                        AutomationProperties.Name="VSR 映像の注目位置をクリックまたはドラッグして選択"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0.01"
                                        Padding="0"
                                        PointerCanceled="OnRealtimePlayerPointerCanceled"
                                        PointerCaptureLost="OnRealtimePlayerPointerCaptureLost"
                                        PointerMoved="OnRealtimePlayerPointerMoved"
                                        PointerPressed="OnRealtimePlayerPointerPressed"
                                        PointerReleased="OnRealtimePlayerPointerReleased"
                                        Tag="Vsr"/>
                                    <Border
                                        Margin="14"
                                        Padding="12,6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}">
                                        <TextBlock
                                            x:Name="VsrRealtimeLabelText"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="VSR real time"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Text="{x:Bind RealtimeStatusText, Mode=OneWay}"
                                    TextWrapping="Wrap"/>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind RealtimeDiagnosticsText, Mode=OneWay}"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock
                                x:Name="RealtimeFocusHelpText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Click the video to zoom around that pixel. Drag to move the focus point."
                                TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </TabViewItem>

                <TabViewItem
                    x:Name="ExportTab"
                    Header="Export MP4"
                    IsClosable="False">
                    <ScrollViewer>
                        <Grid
                            Padding="4,16,4,4"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        x:Name="InputVideoStepText"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="1. Input video"/>
                                    <Button
                                        x:Name="PickInputVideoButton"
                                        AutomationProperties.AutomationId="PickInputVideoButton"
                                        Command="{x:Bind PickInputCommand}"
                                        Content="Choose video"/>
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind InputFileName, Mode=OneWay}"
                                        TextWrapping="Wrap"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind InputDetails, Mode=OneWay}"
                                        TextWrapping="Wrap"/>
                                    <ComboBox
                                        x:Name="OutputScaleComboBox"
                                        Width="200"
                                        AutomationProperties.AutomationId="OutputScaleComboBox"
                                        Header="Output scale"
                                        IsEnabled="{x:Bind CanSelectOutputScale, Mode=OneWay}"
                                        SelectedIndex="3"
                                        SelectionChanged="OnOutputScaleSelectionChanged">
                                        <ComboBoxItem Content="1.25 倍"
                                                      Tag="1.25"/>
                                        <ComboBoxItem Content="1.5 倍"
                                                      Tag="1.5"/>
                                        <ComboBoxItem Content="1.75 倍"
                                                      Tag="1.75"/>
                                        <ComboBoxItem Content="2 倍"
                                                      Tag="2"/>
                                        <ComboBoxItem Content="2.25 倍"
                                                      Tag="2.25"/>
                                        <ComboBoxItem Content="2.5 倍"
                                                      Tag="2.5"/>
                                        <ComboBoxItem Content="2.75 倍"
                                                      Tag="2.75"/>
                                        <ComboBoxItem Content="3 倍"
                                                      Tag="3"/>
                                        <ComboBoxItem Content="3.25 倍"
                                                      Tag="3.25"/>
                                        <ComboBoxItem Content="3.5 倍"
                                                      Tag="3.5"/>
                                        <ComboBoxItem Content="3.75 倍"
                                                      Tag="3.75"/>
                                        <ComboBoxItem Content="4 倍"
                                                      Tag="4"/>
                                    </ComboBox>
                                </StackPanel>

                                <Rectangle
                                    Height="1"
                                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <StackPanel Spacing="8">
                                    <TextBlock
                                        x:Name="OutputStepText"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="2. Output"/>
                                    <Button
                                        x:Name="PickOutputVideoButton"
                                        AutomationProperties.AutomationId="PickOutputVideoButton"
                                        Command="{x:Bind PickOutputCommand}"
                                        Content="Choose output location"/>
                                    <TextBlock
                                        x:Name="ProcessingStepText"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind OutputFileName, Mode=OneWay}"
                                        TextWrapping="Wrap"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind OutputDetails, Mode=OneWay}"
                                        TextWrapping="Wrap"/>
                                </StackPanel>

                                <Rectangle
                                    Height="1"
                                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <StackPanel Spacing="12">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="3. Process"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            AutomationProperties.AutomationId="StartProcessingButton"
                                            Command="{x:Bind StartCommand}"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <FontIcon Glyph="&#xE768;"/>
                                                <TextBlock
                                                    x:Name="StartProcessingText"
                                                    Text="Start VSR processing"/>
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="CancelProcessingButton"
                                            AutomationProperties.AutomationId="CancelProcessingButton"
                                            Grid.Column="1"
                                            Command="{x:Bind CancelCommand}"
                                            Content="Cancel"/>
                                    </Grid>
                                    <ProgressBar
                                        x:Name="ProcessingProgressBar"
                                        AutomationProperties.Name="動画処理の進行状況"
                                        Maximum="100"
                                        Value="{x:Bind ProgressValue, Mode=OneWay}"/>
                                    <TextBlock
                                        AutomationProperties.LiveSetting="Polite"
                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                        TextWrapping="Wrap"/>
                                    <Button
                                        x:Name="OpenOutputFolderButton"
                                        AutomationProperties.AutomationId="OpenOutputFolderButton"
                                        Command="{x:Bind OpenOutputFolderCommand}"
                                        Content="Open output folder"
                                        HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid
                                Grid.Column="1"
                                RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Name="PreviewTitleText"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="Input / saved result preview"/>
                                <Border
                                    Grid.Row="1"
                                    MinHeight="480"
                                    Background="Black"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <MediaPlayerElement
                                        x:Name="PreviewPlayer"
                                        AutomationProperties.AutomationId="VideoPreviewPlayer"
                                        AreTransportControlsEnabled="True"
                                        AutoPlay="False"
                                        Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabViewItem>
            </TabView>

            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE946;"/>
                <TextBlock
                    x:Name="HardwareFooterText"
                    VerticalAlignment="Center"
                    Text="Copilot+ PCs automatically use the NPU; other PCs use the CPU. The GPU is not used."
                    TextWrapping="Wrap"/>
                <HyperlinkButton
                    x:Name="VsrDocumentationLink"
                    AutomationProperties.AutomationId="OpenVsrDocumentationLink"
                    Content="Official documentation"
                    NavigateUri="https://learn.microsoft.com/windows/ai/apis/video-super-resolution"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
