<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsAiVsrCpuDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE714;"/>
            <TextBlock
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Windows AI Video Super Resolution デモ"/>
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="24,16,24,12"
            RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="AI で動画を高解像度化"/>
                <TextBlock
                    Text="リアルタイム比較で効果を確認し、必要に応じて音声付き MP4 として保存できます。"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <InfoBar
                x:Name="HardwareInfoBar"
                Grid.Row="1"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind HardwareMessage, Mode=OneWay}"
                Severity="{x:Bind HardwareSeverity, Mode=OneWay}"
                Title="実行ハードウェア"/>

            <TabView
                Grid.Row="2"
                IsAddTabButtonVisible="False"
                TabWidthMode="SizeToContent">
                <TabViewItem
                    Header="リアルタイム VSR 比較"
                    IsClosable="False">
                    <Grid Padding="4,16,4,4"
                          RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button
                                AutomationProperties.AutomationId="PickRealtimeInputVideoButton"
                                Command="{x:Bind PickInputCommand}"
                                Content="比較する動画を選択"
                                Style="{StaticResource AccentButtonStyle}"/>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind InputFileName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"/>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind InputDetails, Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="PlayPauseRealtimeButton"
                                    Command="{x:Bind PlayPauseRealtimeCommand}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <FontIcon Glyph="&#xE768;"/>
                                        <TextBlock Text="{x:Bind RealtimePlayPauseLabel, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.AutomationId="RestartRealtimeButton"
                                    Command="{x:Bind RestartRealtimeCommand}"
                                    Content="先頭から再生"/>
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="拡大率"/>
                                <Slider
                                    x:Name="RealtimeZoomSlider"
                                    Width="200"
                                    AutomationProperties.AutomationId="RealtimeZoomSlider"
                                    AutomationProperties.Name="リアルタイム比較の拡大率"
                                    ValueChanged="OnRealtimeZoomChanged"/>
                                <TextBlock
                                    Width="58"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind RealtimeZoomText, Mode=OneWay}"/>
                                <Button
                                    AutomationProperties.AutomationId="ResetRealtimeZoomButton"
                                    Command="{x:Bind ResetRealtimeZoomCommand}"
                                    Content="リセット"/>
                            </StackPanel>
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="OriginalRealtimeViewport"
                                Background="Black"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                SizeChanged="OnRealtimeViewportSizeChanged"
                                Tag="Original">
                                <Grid>
                                    <Image
                                        x:Name="OriginalRealtimeImage"
                                        AutomationProperties.AutomationId="OriginalRealtimePlayer"
                                        Source="{x:Bind OriginalRealtimeFrameSource, Mode=OneWay}"
                                        Stretch="Uniform">
                                        <Image.RenderTransform>
                                            <CompositeTransform x:Name="OriginalZoomTransform"/>
                                        </Image.RenderTransform>
                                    </Image>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        AutomationProperties.AutomationId="OriginalRealtimeFocusButton"
                                        AutomationProperties.Name="原画の注目位置をクリックまたはドラッグして選択"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0.01"
                                        Padding="0"
                                        PointerCanceled="OnRealtimePlayerPointerCanceled"
                                        PointerCaptureLost="OnRealtimePlayerPointerCaptureLost"
                                        PointerMoved="OnRealtimePlayerPointerMoved"
                                        PointerPressed="OnRealtimePlayerPointerPressed"
                                        PointerReleased="OnRealtimePlayerPointerReleased"
                                        Tag="Original"/>
                                    <Border
                                        Margin="14"
                                        Padding="12,6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="原画"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border
                                x:Name="VsrRealtimeViewport"
                                Grid.Column="1"
                                Background="Black"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                SizeChanged="OnRealtimeViewportSizeChanged"
                                Tag="Vsr">
                                <Grid>
                                    <Image
                                        x:Name="VsrRealtimeImage"
                                        AutomationProperties.AutomationId="VsrRealtimePlayer"
                                        Source="{x:Bind VsrRealtimeFrameSource, Mode=OneWay}"
                                        Stretch="Uniform">
                                        <Image.RenderTransform>
                                            <CompositeTransform x:Name="VsrZoomTransform"/>
                                        </Image.RenderTransform>
                                    </Image>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        AutomationProperties.AutomationId="VsrRealtimeFocusButton"
                                        AutomationProperties.Name="VSR 映像の注目位置をクリックまたはドラッグして選択"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0.01"
                                        Padding="0"
                                        PointerCanceled="OnRealtimePlayerPointerCanceled"
                                        PointerCaptureLost="OnRealtimePlayerPointerCaptureLost"
                                        PointerMoved="OnRealtimePlayerPointerMoved"
                                        PointerPressed="OnRealtimePlayerPointerPressed"
                                        PointerReleased="OnRealtimePlayerPointerReleased"
                                        Tag="Vsr"/>
                                    <Border
                                        Margin="14"
                                        Padding="12,6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}">
                                        <TextBlock
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="VSR リアルタイム"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Text="{x:Bind RealtimeStatusText, Mode=OneWay}"
                                    TextWrapping="Wrap"/>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind RealtimeDiagnosticsText, Mode=OneWay}"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="映像内をクリックするとその画素を中心に拡大します。ドラッグすると注目点を移動できます。"
                                TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </TabViewItem>

                <TabViewItem
                    Header="MP4 書き出し"
                    IsClosable="False">
                    <ScrollViewer>
                        <Grid
                            Padding="4,16,4,4"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="1. 入力動画"/>
                                    <Button
                                        AutomationProperties.AutomationId="PickInputVideoButton"
                                        Command="{x:Bind PickInputCommand}"
                                        Content="動画を選択"/>
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind InputFileName, Mode=OneWay}"
                                        TextWrapping="Wrap"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind InputDetails, Mode=OneWay}"
                                        TextWrapping="Wrap"/>
                                    <ComboBox
                                        x:Name="OutputScaleComboBox"
                                        Width="200"
                                        AutomationProperties.AutomationId="OutputScaleComboBox"
                                        Header="出力倍率"
                                        IsEnabled="{x:Bind CanSelectOutputScale, Mode=OneWay}"
                                        SelectedIndex="3"
                                        SelectionChanged="OnOutputScaleSelectionChanged">
                                        <ComboBoxItem Content="1.25 倍"
                                                      Tag="1.25"/>
                                        <ComboBoxItem Content="1.5 倍"
                                                      Tag="1.5"/>
                                        <ComboBoxItem Content="1.75 倍"
                                                      Tag="1.75"/>
                                        <ComboBoxItem Content="2 倍"
                                                      Tag="2"/>
                                        <ComboBoxItem Content="2.25 倍"
                                                      Tag="2.25"/>
                                        <ComboBoxItem Content="2.5 倍"
                                                      Tag="2.5"/>
                                        <ComboBoxItem Content="2.75 倍"
                                                      Tag="2.75"/>
                                        <ComboBoxItem Content="3 倍"
                                                      Tag="3"/>
                                        <ComboBoxItem Content="3.25 倍"
                                                      Tag="3.25"/>
                                        <ComboBoxItem Content="3.5 倍"
                                                      Tag="3.5"/>
                                        <ComboBoxItem Content="3.75 倍"
                                                      Tag="3.75"/>
                                        <ComboBoxItem Content="4 倍"
                                                      Tag="4"/>
                                    </ComboBox>
                                </StackPanel>

                                <Rectangle
                                    Height="1"
                                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="2. 出力先"/>
                                    <Button
                                        AutomationProperties.AutomationId="PickOutputVideoButton"
                                        Command="{x:Bind PickOutputCommand}"
                                        Content="保存先を選択"/>
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind OutputFileName, Mode=OneWay}"
                                        TextWrapping="Wrap"/>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind OutputDetails, Mode=OneWay}"
                                        TextWrapping="Wrap"/>
                                </StackPanel>

                                <Rectangle
                                    Height="1"
                                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <StackPanel Spacing="12">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="3. 処理"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            AutomationProperties.AutomationId="StartProcessingButton"
                                            Command="{x:Bind StartCommand}"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <FontIcon Glyph="&#xE768;"/>
                                                <TextBlock Text="VSR 処理を開始"/>
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            AutomationProperties.AutomationId="CancelProcessingButton"
                                            Grid.Column="1"
                                            Command="{x:Bind CancelCommand}"
                                            Content="キャンセル"/>
                                    </Grid>
                                    <ProgressBar
                                        AutomationProperties.Name="動画処理の進行状況"
                                        Maximum="100"
                                        Value="{x:Bind ProgressValue, Mode=OneWay}"/>
                                    <TextBlock
                                        AutomationProperties.LiveSetting="Polite"
                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                        TextWrapping="Wrap"/>
                                    <Button
                                        AutomationProperties.AutomationId="OpenOutputFolderButton"
                                        Command="{x:Bind OpenOutputFolderCommand}"
                                        Content="出力フォルダーを開く"
                                        HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid
                                Grid.Column="1"
                                RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="入力 / 保存結果プレビュー"/>
                                <Border
                                    Grid.Row="1"
                                    MinHeight="480"
                                    Background="Black"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                                    <MediaPlayerElement
                                        x:Name="PreviewPlayer"
                                        AutomationProperties.AutomationId="VideoPreviewPlayer"
                                        AreTransportControlsEnabled="True"
                                        AutoPlay="False"
                                        Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabViewItem>
            </TabView>

            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE946;"/>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="Copilot+ PC では NPU、非 Copilot+ PC では CPU が自動使用されます。GPU は使用されません。"
                    TextWrapping="Wrap"/>
                <HyperlinkButton
                    AutomationProperties.AutomationId="OpenVsrDocumentationLink"
                    Content="公式ドキュメント"
                    NavigateUri="https://learn.microsoft.com/windows/ai/apis/video-super-resolution"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
